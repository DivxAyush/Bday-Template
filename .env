# =========================================================================
# 🎂 BIRTHDAY WEBSITE ENVIRONMENT VARIABLES
# Edit these variables to change names dynamically!
# Restart `npm run dev` after changing .env
# =========================================================================

# Main recipient name (e.g. uknown 1, Sarah, Pragati, Alex)
VITE_RECIPIENT_NAME=uknown 1

# Cute nickname shown on Magazine Cover (e.g. uknown, Sweetheart, Rockstar)
VITE_NICKNAME=uknown

# Your name / sender
VITE_SENDER_NAME=Ayush

# Year or date
VITE_BIRTHDAY_YEAR=2026

# Age transition (e.g. 22 to 23)
VITE_PREV_AGE=22
VITE_NEW_AGE=23

